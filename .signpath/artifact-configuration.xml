<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference copy of the SignPath artifact configuration for widepeek.
  SignPath does not read this file. Paste it into the project's artifact
  configuration on app.signpath.io and keep both copies the same.

  The GitHub artifact is a zip file with widepeek.exe at its root.
  SignPath signs only an exe whose version info has the product name
  "widepeek" and the product version that CI sends as "version".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="widepeek.exe" product-name="widepeek" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
